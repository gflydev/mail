# NOTE: Mail settings:
MAIL_PROTOCOL=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=no-reply@gfly.dev
MAIL_NAME="gFly - No Reply"
MAIL_TLS=true
# Set to true ONLY for development servers with self-signed certificates.
# Leaving this false verifies the server certificate (recommended).
MAIL_TLS_SKIP_VERIFY=false